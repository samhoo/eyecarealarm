{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for the three app windows",
  "windows": ["panel", "overlay-*", "toast"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-set-size",
    "core:window:allow-set-focus",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://www.healthline.com/**" }]
    }
  ]
}
